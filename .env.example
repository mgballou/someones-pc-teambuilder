# Copy to .env.local and fill in.
#
# The default DATABASE_URL matches docker-compose.yml, so `pnpm setup` works
# with no edits. Change it only if you are pointing at your own Postgres.

DATABASE_URL=postgresql://spc:spc@localhost:5433/someones_pc

# Any 32+ character random string. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=

# Optional. With no provider configured the app uses the demo credentials
# sign-in, which is enough to run and review everything.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
