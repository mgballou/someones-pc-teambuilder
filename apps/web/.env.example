# Copy to .env.local, in this directory. `next dev`, `pnpm db:push` and
# `pnpm db:seed` all read that file and nothing else.
#
# You do not need one to start. With no DATABASE_URL set, every entry point
# falls back to the Postgres `docker-compose.yml` starts, so `pnpm setup` works
# on a clean clone with no edits. Set it here to point at your own instead.
#
# DATABASE_URL is the only variable the app reads.

DATABASE_URL=postgresql://spc:spc@localhost:5433/someones_pc
